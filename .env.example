# TalentMatch AI Configuration
PROJECT_NAME="TalentMatch AI — NLP-Based Talent Intelligence & Job Matching Platform"
PROJECT_VERSION="1.0.0"

# Database Configuration (PostgreSQL / SQLite)
# For local SQLite: sqlite:///./talentmatch.db
# For Docker PostgreSQL: postgresql://postgres:postgres@db:5432/talentmatch
DATABASE_URL=sqlite:///./talentmatch.db

# NLP Configurable Scoring Weights (Must sum to 1.0)
WEIGHT_SKILL_MATCH=0.45
WEIGHT_SEMANTIC_SIM=0.30
WEIGHT_EXPERIENCE_MATCH=0.15
WEIGHT_EDUCATION_MATCH=0.10

# Similarity Blend Weights
WEIGHT_TFIDF=0.45
WEIGHT_WORD2VEC=0.55

# Fuzzy Matching Thresholds
FUZZY_MATCH_THRESHOLD=0.82
SEMANTIC_SKILL_THRESHOLD=0.70
